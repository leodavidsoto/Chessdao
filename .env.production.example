# ChessDAO TON Production Environment Configuration
# Copy this to .env.local or set in Railway dashboard

# ========================================
# BACKEND URLs
# ========================================
NEXT_PUBLIC_API_URL=https://chessdao-production.up.railway.app
NEXT_PUBLIC_WS_URL=https://chessdao-production.up.railway.app

# ========================================
# TON BLOCKCHAIN CONFIGURATION
# ========================================
# Network: mainnet or testnet
NEXT_PUBLIC_TON_NETWORK=mainnet

# TON Center API (or your own TON endpoint)
NEXT_PUBLIC_TON_RPC_URL=https://toncenter.com/api/v2/jsonRPC
NEXT_PUBLIC_TON_API_KEY=your_toncenter_api_key

# CHESS Jetton Address (after deploy to TON)
NEXT_PUBLIC_CHESS_JETTON=YOUR_TON_JETTON_ADDRESS

# ========================================
# TREASURY WALLET (TON)
# ========================================
# Your business wallet that receives payments
NEXT_PUBLIC_TREASURY_WALLET=YOUR_TON_TREASURY_WALLET
TREASURY_WALLET=YOUR_TON_TREASURY_WALLET

# ========================================
# TOKEN PRICING
# ========================================
# Price per CHESS token in USD
CHESS_TOKEN_PRICE=0.01

# ========================================
# DATABASE
# ========================================
# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/chessdao?retryWrites=true&w=majority
# Database name (defaults to dao_chess). Games, balances and payments all live here.
MONGO_DB_NAME=dao_chess

# ========================================
# SECURITY / AUTH  (see SECURITY.md)
# ========================================
# Enforcement for wallet-signature auth on player actions:
#   strict = reject unverified/mismatched requests (REQUIRED in production)
#   warn   = verify when present, otherwise allow + log (rollout only)
AUTH_MODE=strict

# Max age (ms) of a signed action message before it is rejected as stale (replay window).
AUTH_MAX_AGE_MS=300000

# Shared secret for the trusted game backend/oracle. REQUIRED in production:
# without it, /api/game/resolve (which settles the pot) is disabled. Generate a
# long random value, e.g.  openssl rand -hex 32
GAME_ORACLE_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Comma-separated list of browser origins allowed to call the API cross-origin.
# The app's own origin and localhost/Capacitor are allowed by default.
ALLOWED_ORIGINS=https://chessdao-production.up.railway.app

# Seed demo games into the in-memory store when Mongo is absent. Set to false
# to start with an empty lobby.
SEED_DEMO_GAMES=true

# ========================================
# TELEGRAM BOT
# ========================================
BOT_TOKEN=your_telegram_bot_token
WEBAPP_URL=https://chessdao-production.up.railway.app
API_URL=https://chessdao-production.up.railway.app

# ========================================
# PRODUCTION CHECKLIST
# ========================================
# [ ] Deploy CHESS Jetton to TON mainnet
# [ ] Update NEXT_PUBLIC_CHESS_JETTON with address
# [ ] Set up production MongoDB Atlas cluster
# [ ] Configure Telegram Bot webhook
# [ ] Test full TON Connect flow
# [ ] Enable SSL/HTTPS
